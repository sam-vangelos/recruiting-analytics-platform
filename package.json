  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:red": "vitest run --config vitest.red.config.ts",
    "test:mutation": "node scripts/recruiting-ops-mutation-corpus.mjs",
    "typecheck": "tsc --noEmit",
    "check:recruiting-ops-architecture": "node scripts/recruiting-ops-architecture-check.mjs",
    "check:recruiting-ops": "npm run check:recruiting-ops-architecture && npm test -- test/recruiting-ops-registries.test.ts test/recruiting-ops-capabilities.test.ts test/recruiting-ops-capability-binding.test.ts test/recruiting-ops-automation-seed-matrix.test.ts",
    "employee-referral-report:operator": "node scripts/employee-referral-report-operator-launcher.mjs",
    "mcp:greenhouse:verify-rollout": "npm --prefix mcp/greenhouse/scoped-recruiter-mcp run verify:rollout",
    "control:rps-automated-surfaces": "jiti scripts/recruiting-ops/rps-automated-surfaces.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.1",
    "google-auth-library": "10.5.0",
    "googleapis": "^173.0.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "next@16.2.11": {
      "postcss": "8.5.10",
      "sharp": "0.35.3"
    }
  }
}
